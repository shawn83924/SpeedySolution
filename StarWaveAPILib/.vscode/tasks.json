{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build (Debug)",
            "type": "shell",
            "command": "make",
            "args": ["CONF=Debug", "build"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "clean (Debug)",
            "type": "shell",
            "command": "make",
            "args": ["CONF=Debug", "clean"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build (Release)",
            "type": "shell",
            "command": "make",
            "args": ["CONF=Release", "build"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build (Release_64)",
            "type": "shell",
            "command": "make",
            "args": ["CONF=Release_64", "build"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$gcc"]
        }
    ]
}
