		<Target DependsOnTargets="SpeedyAPITMPLib:Make" Name="TMPOrderConnection:Make">
			<MSBuild Targets="Make" Projects="TMPOrderConnection\TMPOrderConnection.cbproj"/>
		</Target>
		<Target Name="Build">
			<CallTarget Targets="UFC;SpeedyAPITMPLib;TMPOrderConnection"/>
		</Target>
		<Target Name="Clean">
			<CallTarget Targets="UFC:Clean;SpeedyAPITMPLib:Clean;TMPOrderConnection:Clean"/>
		</Target>
		<Target Name="Make">
			<CallTarget Targets="UFC:Make;SpeedyAPITMPLib:Make;TMPOrderConnection:Make"/>
		</Target>
		<Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
	</Project>
