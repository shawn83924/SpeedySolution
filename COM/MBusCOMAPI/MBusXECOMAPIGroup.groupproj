            <Dependencies>..\..\BC Projects\UFC_XE7.cbproj</Dependencies>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="UFC_XE7">
        <MSBuild Projects="..\..\BC Projects\UFC_XE7.cbproj"/>
