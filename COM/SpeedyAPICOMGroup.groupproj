	<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
		<PropertyGroup>
			<ProjectGuid>{1a9a0e15-4f24-4a9d-a90c-861e7bcb8e1a}</ProjectGuid>
		</PropertyGroup>
		<ItemGroup>
			<Projects Include="..\BC Projects\UFC.cbproj">
				<Dependencies/>
			</Projects>
			<Projects Include="Lib\SpeedyAPILib.cbproj">
				<Dependencies>..\BC Projects\UFC.cbproj</Dependencies>
			</Projects>
			<Projects Include="OrderConnection\OrderConnection.cbproj">
				<Dependencies>..\BC Projects\UFC.cbproj;Lib\SpeedyAPILib.cbproj</Dependencies>
			</Projects>
		</ItemGroup>
		<ProjectExtensions>
			<Borland.Personality>Default.Personality.12</Borland.Personality>
			<Borland.ProjectType/>
			<BorlandProject>
				<BorlandProject>
					<Default.Personality/>
				</BorlandProject>
			</BorlandProject>
		</ProjectExtensions>
		<Target Name="UFC">
			<MSBuild Projects="..\BC Projects\UFC.cbproj"/>
		</Target>
		<Target Name="UFC:Clean">
			<MSBuild Targets="Clean" Projects="..\BC Projects\UFC.cbproj"/>
		</Target>
		<Target Name="UFC:Make">
			<MSBuild Targets="Make" Projects="..\BC Projects\UFC.cbproj"/>
		</Target>
		<Target DependsOnTargets="UFC" Name="SpeedyAPILib">
			<MSBuild Projects="Lib\SpeedyAPILib.cbproj"/>
		</Target>
		<Target DependsOnTargets="UFC:Clean" Name="SpeedyAPILib:Clean">
			<MSBuild Targets="Clean" Projects="Lib\SpeedyAPILib.cbproj"/>
		</Target>
		<Target DependsOnTargets="UFC:Make" Name="SpeedyAPILib:Make">
			<MSBuild Targets="Make" Projects="Lib\SpeedyAPILib.cbproj"/>
		</Target>
		<Target DependsOnTargets="UFC;SpeedyAPILib" Name="OrderConnection">
			<MSBuild Projects="OrderConnection\OrderConnection.cbproj"/>
		</Target>
		<Target DependsOnTargets="UFC:Clean;SpeedyAPILib:Clean" Name="OrderConnection:Clean">
			<MSBuild Targets="Clean" Projects="OrderConnection\OrderConnection.cbproj"/>
		</Target>
		<Target DependsOnTargets="UFC:Make;SpeedyAPILib:Make" Name="OrderConnection:Make">
			<MSBuild Targets="Make" Projects="OrderConnection\OrderConnection.cbproj"/>
		</Target>
		<Target Name="Build">
			<CallTarget Targets="UFC;SpeedyAPILib;OrderConnection"/>
		</Target>
		<Target Name="Clean">
			<CallTarget Targets="UFC:Clean;SpeedyAPILib:Clean;OrderConnection:Clean"/>
		</Target>
		<Target Name="Make">
			<CallTarget Targets="UFC:Make;SpeedyAPILib:Make;OrderConnection:Make"/>
		</Target>
		<Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
	</Project>
