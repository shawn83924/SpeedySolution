	<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
		<PropertyGroup>
			<ProjectGuid>{4500850F-BE0E-4C11-B376-A641E56630D8}</ProjectGuid>
		</PropertyGroup>
		<ItemGroup>
			<Projects Include="..\..\BC Projects\UFC.cbproj">
				<Dependencies/>
			</Projects>
			<Projects Include="..\Lib\SpeedyAPILib.cbproj">
				<Dependencies/>
			</Projects>
			<Projects Include="OrderConnection.cbproj">
				<Dependencies>..\..\BC Projects\UFC.cbproj;..\Lib\SpeedyAPILib.cbproj</Dependencies>
			</Projects>
		</ItemGroup>
		<ProjectExtensions>
			<Borland.Personality>Default.Personality.12</Borland.Personality>
			<Borland.ProjectType/>
			<BorlandProject>
				<Default.Personality/>
			</BorlandProject>
		</ProjectExtensions>
		<Target Name="UFC">
			<MSBuild Projects="..\..\BC Projects\UFC.cbproj"/>
		</Target>
		<Target Name="UFC:Clean">
			<MSBuild Targets="Clean" Projects="..\..\BC Projects\UFC.cbproj"/>
		</Target>
		<Target Name="UFC:Make">
			<MSBuild Targets="Make" Projects="..\..\BC Projects\UFC.cbproj"/>
		</Target>
		<Target Name="SpeedyAPILib">
			<MSBuild Projects="..\Lib\SpeedyAPILib.cbproj"/>
		</Target>
		<Target Name="SpeedyAPILib:Clean">
			<MSBuild Targets="Clean" Projects="..\Lib\SpeedyAPILib.cbproj"/>
		</Target>
		<Target Name="SpeedyAPILib:Make">
			<MSBuild Targets="Make" Projects="..\Lib\SpeedyAPILib.cbproj"/>
		</Target>
		<Target DependsOnTargets="UFC;SpeedyAPILib" Name="OrderConnection">
			<MSBuild Projects="OrderConnection.cbproj"/>
		</Target>
		<Target DependsOnTargets="UFC:Clean;SpeedyAPILib:Clean" Name="OrderConnection:Clean">
			<MSBuild Targets="Clean" Projects="OrderConnection.cbproj"/>
		</Target>
		<Target DependsOnTargets="UFC:Make;SpeedyAPILib:Make" Name="OrderConnection:Make">
			<MSBuild Targets="Make" Projects="OrderConnection.cbproj"/>
		</Target>
		<Target Name="Build">
			<CallTarget Targets="UFC;SpeedyAPILib;OrderConnection"/>
		</Target>
		<Target Name="Clean">
			<CallTarget Targets="UFC:Clean;SpeedyAPILib:Clean;OrderConnection:Clean"/>
		</Target>
		<Target Name="Make">
			<CallTarget Targets="UFC:Make;SpeedyAPILib:Make;OrderConnection:Make"/>
		</Target>
		<Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
	</Project>
