void SinoPacExecConnection:ConfirmToBackend( char Func, TExecutionReportMessage* Msg ) {}
void SinoPacExecConnection::FillToBackend( TExecutionReportMessage* Msg ) {}
void SinoPacExecConnection::OnExecutionReport( TExecutionReportMessage* Msg, bool PossDup ) {}
void SinoPacExecConnection::NewOrder(  UFC::AnsiString& Order ) {}
