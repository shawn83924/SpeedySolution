  [
    uuid(1AE89F65-E901-4703-81E5-87A562181F4C),
    helpstring("Events interface for OrderConnection Object")
  ]
  dispinterface IOrderConnectionEvents
  {
    properties:
    methods:
    [id(0x00000000), helpstring("Occurs when this connection object connected to the order gateway.")]
    HRESULT OnConnected(void);
    [id(0x00000001), helpstring("Occurs when this connection object disconnected.")]
    HRESULT OnDisconnected(void);
    [id(0x00000003), helpstring("Occurs when an execution report arrived.")]
    HRESULT OnExecutionReport([in] IExecutionReportMessage* Msg, [in] enum ExecDupEnum ExecPossDup);
    [id(0x00000004), helpstring("Occurs when recover execution reports finished.")]
    HRESULT OnRecoverFinished([in] long Count);
    [id(0x00000005), helpstring("Received a new message.")]
    HRESULT OnNews([in] INewsMessage* News);
    [id(0x000000C9)]
    HRESULT OnLogonReply([in] BSTR Message, [in] enum LogonResultEnum Result, [in] long ConnectionID);
    [id(0x000000CA)]
    HRESULT OnCancelWorking([in] enum CancelWorkingResultEnum Result, [in] long Count);
    [id(0x000000CB)]
    HRESULT OnChangePasswordReply([in] enum ChangePasswordEnum Result, [in] BSTR Message);
  };

