{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build (Solaris_Debug)",
            "type": "shell",
            "command": "make",
            "args": [
                "CONF=Solaris_Debug",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
